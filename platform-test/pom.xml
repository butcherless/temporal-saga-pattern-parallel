<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bravo.saga</groupId>
        <artifactId>distributed-saga-platform-temporal-parallel</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>platform-test</artifactId>
    <packaging>jar</packaging>

    <name>platform-test</name>
    <description>End-to-end Testcontainers-Postgres + Temporal dev server test module. No *IT.java yet — flight/hotel/car/payment-service
        have no REST contract to drive a real happy-path saga through; see CLAUDE.md. Structure mirrors temporal-saga-pattern's
        platform-test so an equivalent HappyPathSagaIT slots in once those services exist.</description>

    <dependencies>
        <!-- Brings in temporal-sdk transitively (WorkflowClient/WorkflowServiceStubs), for
             asserting the Workflow Execution itself closed as COMPLETED, once an IT exists. -->
        <dependency>
            <groupId>com.bravo.saga</groupId>
            <artifactId>saga-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Not used in-process (a future IT would never start a Spring context of its own — each
             service would run as its own forked `java -jar` process, same reason as
             temporal-saga-pattern's TemporalEndToEndSagaIT: identically-named classpath resources
             across service jars rule out an in-process shared classloader). Declared purely so
             Maven's reactor build order guarantees their jars already exist by the time this
             module's integration-test phase runs. -->
        <dependency>
            <groupId>com.bravo.saga</groupId>
            <artifactId>booking-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bravo.saga</groupId>
            <artifactId>flight-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bravo.saga</groupId>
            <artifactId>hotel-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bravo.saga</groupId>
            <artifactId>car-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bravo.saga</groupId>
            <artifactId>payment-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bravo.saga</groupId>
            <artifactId>saga-orchestrator-temporal</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JDBC-only, to poll travel_booking.status directly against the shared Testcontainers
             Postgres instance, in addition to asserting on the Workflow Execution's own status. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Versions come from the Spring Boot BOM's imported testcontainers-bom. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Runs *IT.java (Testcontainers, needs Docker) during integration-test/verify,
                 keeping mvn test (surefire, *Test.java) Docker-free and fast. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Lets the IT compute each sibling module's built jar path
                             (../<module>/target/<module>-${saga.platform.version}-exec.jar) without
                             hardcoding the version. -->
                        <saga.platform.version>${project.version}</saga.platform.version>
                        <!-- The `-javaagent:…jacocoagent.jar=destfile=…` string from the root pom's
                             jacoco-prepare-agent-integration execution. TravelBookingEndToEndSagaIT
                             rewrites its destfile per service and prepends it to each forked
                             `java -jar`, so the e2e run is measured in the service JVMs (this test
                             JVM runs only the harness). Empty/unset when the lifecycle did not run
                             that goal — the IT treats a blank or unresolved value as "off". -->
                        <jacoco.it.argLine>${jacocoItArgLine}</jacoco.it.argLine>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Merges the per-service e2e exec files the forked JVMs dumped into one
                 jacoco-it/merged.exec, for a manual `jacoco:report`/IDE import over the whole run.
                 Per-service HTML is rendered separately by the root pom's jacoco-report-integration,
                 from each service module reading its own jacoco-it/<module>.exec. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-merge-integration</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}/jacoco-it</directory>
                                    <includes>
                                        <include>*.exec</include>
                                    </includes>
                                    <excludes>
                                        <exclude>merged.exec</exclude>
                                    </excludes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-it/merged.exec</destFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bravo.saga</groupId>
    <artifactId>distributed-saga-platform-temporal-parallel</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>distributed-saga-platform-temporal-parallel</name>
    <description>Orchestrated Saga on Java, Spring Boot, PostgreSQL and Temporal — a genuinely parallel fan-out
        (flight/hotel/car reservations, gated by a single payment hold/capture step) contrasted against
        distributed-saga-platform-temporal's dependent, strictly sequential order chain</description>

    <modules>
        <module>saga-common</module>
        <module>leg-common</module>
        <module>saga-orchestrator-temporal</module>
        <module>booking-service</module>
        <module>flight-service</module>
        <module>hotel-service</module>
        <module>car-service</module>
        <module>payment-service</module>
        <module>platform-test</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <maven.min.version>3.9.0</maven.min.version>

        <spring-boot.version>4.1.2</spring-boot.version>
        <!-- Same floor and same reason as temporal-saga-pattern's root pom: 1.38.0 is required for
             https://github.com/temporalio/sdk-java/pull/2957, which VirtualThreadWorkerOptionsCustomizer
             relies on being correct to keep virtual threads scoped to the Activity worker only. -->
        <temporal.version>1.40.0</temporal.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- Not managed by the Spring Boot BOM. -->
        <springdoc.version>3.2.0</springdoc.version>
        <!-- Matches the version the Spring Boot BOM manages; pinned explicitly because
             annotationProcessorPaths entries below don't inherit from dependencyManagement. -->
        <lombok.version>1.18.48</lombok.version>

        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <!-- Not managed by the Spring Boot BOM; only modules with Testcontainers-based
             integration tests (*IT.java) bind this plugin explicitly. -->
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
        <!-- 0.8.15 is the first release with official (not experimental) Java 25 class-file support. -->
        <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
        <!-- Not managed by the Spring Boot BOM; only leg-common binds this plugin explicitly, to
             publish a test-jar of its test-support helpers for flight-service/hotel-service/car-service
             to share. -->
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Same internal inconsistency in temporal-sdk's own transitive graph as
                 temporal-saga-pattern's root pom documents (confirmed there via
                 `mvn dependency:tree -Dverbose`) — pinned here for the same reason, since this
                 repo pulls in the same temporal-sdk. Versions track the highest any path in the
                 graph requests; the Spring Boot 4.1.2 BOM aligned gRPC to 1.83.1, which raised
                 the ceiling on error_prone_annotations (2.45.0 -> 2.50.0) and pulled gson above
                 the BOM-managed 2.13.2, so gson is pinned here too now. -->
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>2.50.0</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>2.14.0</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.5.0-android</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <!-- Same repackage/verify/classifier=exec setup as temporal-saga-pattern's root
                         pom: spring-boot-starter-parent isn't inherited here either, so repackage
                         needs an explicit execution, bound to verify (not package), with a separate
                         "exec" classifier. -->
                    <executions>
                        <execution>
                            <phase>verify</phase>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                            <configuration>
                                <classifier>exec</classifier>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-rules</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <fail>true</fail>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[${maven.min.version},)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps>
                                    <excludes>
                                        <!-- Same Spring Boot BOM pinning exceptions as
                                             temporal-saga-pattern's root pom — not specific to the
                                             order vs. travel-booking domain. -->
                                        <exclude>io.prometheus:prometheus-metrics-core</exclude>
                                        <exclude>io.prometheus:prometheus-metrics-exposition-formats</exclude>
                                        <exclude>io.prometheus:prometheus-metrics-tracer-common</exclude>
                                        <exclude>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</exclude>
                                        <exclude>com.fasterxml.jackson.dataformat:jackson-dataformat-yaml</exclude>
                                        <exclude>com.google.guava:guava</exclude>
                                    </excludes>
                                </requireUpperBoundDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- E2E coverage. prepare-agent-integration resolves the JaCoCo runtime agent
                         and publishes the `-javaagent:…=destfile=…` string as the `jacocoItArgLine`
                         property. Nothing here uses it in-JVM: platform-test's TravelBookingEndToEndSagaIT
                         starts the six services as forked `java -jar` processes, and it reads this
                         property (passed through as the `jacoco.it.argLine` system property by
                         platform-test's failsafe config) to prepend a per-service `-javaagent` to each
                         fork, each dumping to platform-test/target/jacoco-it/<module>.exec on shutdown.
                         report-integration then renders each service's own e2e .exec into
                         target/site/jacoco-it/. It auto-skips (logged, non-fatal) for modules with no
                         matching .exec — saga-common, leg-common, platform-test — and on any build
                         where the IT has not run yet, so it is one build behind the run that produced
                         the data (see CLAUDE.md, "E2E code coverage"). -->
                    <execution>
                        <id>jacoco-prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoItArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report-integration</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.basedir}/../platform-test/target/jacoco-it/${project.artifactId}.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-it</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

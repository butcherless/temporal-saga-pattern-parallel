<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bravo.saga</groupId>
        <artifactId>distributed-saga-platform-temporal-parallel</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>leg-common</artifactId>
    <packaging>jar</packaging>

    <name>leg-common</name>
    <description>Shared reservation-leg types for flight-service/hotel-service/car-service: status
        state machine, illegal-transition and simulated-fault exceptions, the shared step-request
        record, the reservation response body, and the RFC 9457 exception handler.</description>

    <dependencies>
        <dependency>
            <groupId>com.bravo.saga</groupId>
            <artifactId>saga-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- The shared LegReservationProgressionService talks to a Spring Data
             ReactiveCrudRepository; each leg service passes its own concrete repository in. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- The web layer this module contributes (RestControllerAdvice + response DTO) needs the
             reactive web stack and the OpenAPI annotations, same two starters the three leg
             services already declare. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>3.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Publishes src/test/java as a test-jar so flight-service/hotel-service/car-service
                 can depend on leg-common's shared controller-test support (see
                 com.bravo.saga.leg.web.LegControllerTestSupport) instead of each redeclaring it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
